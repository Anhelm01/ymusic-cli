/* YMusic CLI — True Linux Cmus-style Stylesheet */

Screen {
    background: #000000;
    color: #cccccc;
    layers: base overlay;
}

/* ── Top Header ── */
#top-bar {
    dock: top;
    height: 1;
    background: #121212;
    color: #888888;
    padding: 0 1;
}

#top-bar .active-tab {
    color: #00ff7f;
    text-style: bold;
}

#top-bar .inactive-tab {
    color: #00bfff;
}

#top-bar .inactive-tab:hover {
    color: #ffffff;
}

#top-bar .user-badge {
    color: #e0e0e0;
}

/* ── Main Track Table ── */
#track-table {
    height: 1fr;
    background: #000000;
    border: none;
    padding: 0;
}

DataTable {
    background: #000000;
    border: none;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: #181818;
    color: #00e5ff;
    text-style: bold;
    height: 1;
}

DataTable > .datatable--cursor {
    background: #1c3d5a;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #0d1e2d;
}

/* ── Bottom Player Bar (Cmus style) ── */
#player-bar {
    dock: bottom;
    height: 3;
    background: #0a0a0a;
    border-top: solid #222222;
    padding: 0;
}

#status-line {
    height: 1;
    padding: 0 1;
    color: #00ff7f;
    text-style: bold;
}

#progress-line {
    height: 1;
    padding: 0 1;
    color: #00bfff;
}

#cmd-line {
    height: 1;
    padding: 0 1;
    color: #777777;
}

#prompt-container {
    dock: bottom;
    height: 1;
    background: #121212;
    display: none;
}

#prompt-label {
    width: auto;
    color: #00ff7f;
    text-style: bold;
    padding: 0 1;
}

#prompt-input {
    width: 1fr;
    height: 1;
    border: none;
    background: #121212;
    color: #ffffff;
    padding: 0;
}

/* ── Help Screen ── */
#help-container {
    align: center middle;
    width: 100%;
    height: 100%;
}

#help-box {
    width: 72;
    height: auto;
    background: #0d0d0d;
    border: solid #00e5ff;
    padding: 1 2;
}

#help-title {
    text-align: center;
    text-style: bold;
    color: #00e5ff;
    margin-bottom: 1;
}

.help-category {
    color: #ffaa00;
    text-style: bold;
    margin-top: 1;
}

.help-entry {
    color: #cccccc;
}

.help-key {
    color: #00ff7f;
    text-style: bold;
}
